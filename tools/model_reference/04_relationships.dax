// Model reference: the relationships. The generated id of a relationship is left out.
EVALUATE
SELECTCOLUMNS (
    INFO.VIEW.RELATIONSHIPS (),
    "From Table", [FromTable],
    "From Column", [FromColumn],
    "From Cardinality", [FromCardinality],
    "To Table", [ToTable],
    "To Column", [ToColumn],
    "To Cardinality", [ToCardinality],
    "Is Active", [IsActive],
    "Cross Filtering", [CrossFilteringBehavior],
    "Security Filtering", [SecurityFilteringBehavior]
)
ORDER BY [From Table], [From Column], [To Table], [To Column]
