      "fontFace": "Segoe UI",
      "color": "#374151"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "alignment": "left"
          }
        ],
        "subTitle": [
