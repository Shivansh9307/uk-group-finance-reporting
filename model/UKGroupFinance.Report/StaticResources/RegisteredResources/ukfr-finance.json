    "#56B4E9",
    "#009E73",
    "#D55E00",
    "#CC79A7",
    "#F0E442",
    "#555555"
  ],
  "good": "#0072B2",
  "neutral": "#6B7280",
  "bad": "#D55E00",
  "maximum": "#0072B2",
  "center": "#F3F4F6",
  "minimum": "#D55E00",
  "null": "#9CA3AF",
  "firstLevelElements": "#1F2937",
  "secondLevelElements": "#4B5563",
  "thirdLevelElements": "#E5E7EB",
  "fourthLevelElements": "#D1D5DB",
  "foreground": "#1F2937",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F4F6",
