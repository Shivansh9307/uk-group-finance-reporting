            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D1D5DB"
              }
            },
            "width": 1,
            "radius": 0
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 6,
            "bottom": 6,
            "left": 8,
            "right": 8
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D1D5DB"
              }
            },
            "width": 1,
            "radius": 0
          }
        ],
        "value": [
          {
            "labelDisplayUnits": 1,
            "fontSize": 24
          }
        ]
      }
    }
