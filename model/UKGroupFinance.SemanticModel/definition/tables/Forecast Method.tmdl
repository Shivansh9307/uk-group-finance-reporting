/// Labels only, no number: the four forecast methods and what each one is. The department's own forecast is the real return; run rate, seasonal and FTE x cost are my own methods (FTE x cost is for the pay line only). Source view dw.v_model_forecast_method.
table 'Forecast Method'
	lineageTag: a68c8ee0-6fea-4db5-81ff-b50813ee3f4f

	/// department, run_rate, seasonal or fte_cost.
	column 'Method Key'
		dataType: string
		isKey
		isHidden
		isAvailableInMdx: false
		lineageTag: 1f3bc3cb-d70e-4322-ae9c-1c1facd28abf
		summarizeBy: none
		sourceColumn: method

	/// 1 to 4: the order the methods are shown in.
	column 'Method Order'
