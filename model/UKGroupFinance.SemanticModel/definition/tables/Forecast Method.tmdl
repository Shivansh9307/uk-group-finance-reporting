		lineageTag: 6712cda7-95d2-4d6f-bc7d-deb32376d2e0
		summarizeBy: none
		sourceColumn: method_name
		sortByColumn: 'Method Order'

	/// What the method forecasts and where it exists.
	column Definition
		dataType: string
		displayFolder: Forecast accuracy
		lineageTag: 96828507-794e-46ed-b6d6-707361d69e60
