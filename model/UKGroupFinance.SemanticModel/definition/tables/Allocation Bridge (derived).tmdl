		lineageTag: d366a0de-f175-4cd1-8eac-734c9e127a64
		summarizeBy: none
		sourceColumn: department_key

	/// The weight, as stored (a ratio, stored as a floating-point number because the fixed-decimal type keeps four decimals only). Hidden: use the measure Allocation Weight.
	column 'Weight (stored)'
		dataType: double
		isHidden
		formatString: 0.0000000000
		isAvailableInMdx: false
		lineageTag: 740d50f1-5d5e-4511-9370-8c38820dc551
		summarizeBy: none
		sourceColumn: weight

	/// The allocated amount in GBP thousands, with the rounding adjustment included. Hidden: use the measure Allocated Amount.
	column 'Allocated Amount (stored)'
		dataType: decimal
		isHidden
		formatString: #,##0.0000
		isAvailableInMdx: false
		lineageTag: c488da0e-4ceb-4583-af5c-8aeefe22b8e8
		summarizeBy: none
		sourceColumn: allocated_amount

	/// The rounding adjustment on this row, GBP thousands: zero except on the row of the largest weight. Hidden: use the measure Allocation Rounding Adjustment.
	column 'Rounding Adjustment (stored)'
		dataType: decimal
		isHidden
		formatString: #,##0.0000
		isAvailableInMdx: false
		lineageTag: 3e810c21-aaa9-4f31-b4c1-912ec6174d2d
		summarizeBy: none
		sourceColumn: rounding_adjustment

	/// True on the one row of each pool that carries the rounding adjustment: the participant with the largest full-time equivalent.
	column 'Rounding Row'
		dataType: boolean
		displayFolder: Derived
		lineageTag: 751568f2-b954-4e1b-97f8-9f7ca7e0050b
