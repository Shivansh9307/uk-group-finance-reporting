		summarizeBy: none
		sourceColumn: avg_fte

	/// Months of the financial year in which the department has a valid payroll cell: the weight rests on these months only, and a department needs at least the rule's minimum to take part.
	column 'Months With Data'
		dataType: int64
		formatString: 0
		displayFolder: Derived
		lineageTag: 25b86b2b-e6b4-4a02-b44d-b654d50fa729
