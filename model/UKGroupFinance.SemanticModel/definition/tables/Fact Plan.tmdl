	/// True for administration budgets, which are part of resource DEL and are never added to it.
	column 'Is Part Of Other Measure'
		dataType: boolean
		lineageTag: 17b9b228-df63-5621-b272-0e5ab0a852f4
		summarizeBy: none
		sourceColumn: is_part_of_other_measure

	partition 'Fact Plan' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Data = Source{[Schema = "dw", Item = "v_model_fact_plan"]}[Data]
				in
				    Data

