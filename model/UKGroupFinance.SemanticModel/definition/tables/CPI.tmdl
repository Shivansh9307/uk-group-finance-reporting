/// Office for National Statistics consumer price series, monthly: D7BT, the CPI index (2015 = 100), and D7G7, the annual rate (per cent). Read over the web from the two generator links pinned in the file manifest. The files are regenerated by the publisher each month, so the model can hold later months than the pinned copies. Not related to Fiscal Period: it reaches back to 1988, and a relationship would add a blank period. Real, published data; internet needed at refresh.
table CPI
	lineageTag: 13e6a9dc-52e1-5909-87bb-b852f6c67dd9

	/// ONS CDID: D7BT or D7G7.
	column 'Series Id'
		dataType: string
		lineageTag: 6ddcfe6d-a215-5498-952e-cc8ac9cc2950
		summarizeBy: none
		sourceColumn: Series Id

	/// Title given by ONS.
	column 'Series Title'
		dataType: string
		lineageTag: d15d4042-857b-5b12-85c7-6d7a1981f6a5
		summarizeBy: none
		sourceColumn: Series Title

	/// Unit given by ONS.
	column Unit
		dataType: string
		lineageTag: cbc46939-c25b-5387-abee-3b2b19450650
		summarizeBy: none
		sourceColumn: Unit

	/// First day of the month the value is for.
	column 'Month Start Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: fcf29fff-cdf8-5392-9deb-1f42cd2895ed
		summarizeBy: none
		sourceColumn: Month Start Date

	/// Index level (D7BT) or annual rate in per cent (D7G7).
	column 'CPI Value'
		dataType: double
		formatString: 0.0
		lineageTag: 125b7e99-c060-5eea-8295-fa686d2e9ee9
		summarizeBy: none
		sourceColumn: Value

	/// Release date written in the file.
	column 'Release Date'
		dataType: string
		lineageTag: 8a955762-dcff-5cbe-8f15-0d427c7ac48f
		summarizeBy: none
		sourceColumn: Release Date

	/// File the row was read from.
	column 'Source File'
		dataType: string
		lineageTag: a1a87013-d043-531e-aaac-ca7950cbfeb8
		summarizeBy: none
		sourceColumn: FileName

	partition CPI = m
		mode: import
		source =
				let
				    Parsed = Table.AddColumn(#"CPI Raw", "Parsed", (r) => fnParseCpi(r[FileName], r[Data]), type table),
				    Kept = Table.SelectColumns(Parsed, {"FileName", "Parsed"}),
				    Expanded = Table.ExpandTableColumn(Kept, "Parsed", {"Series Id", "Series Title", "Unit", "Release Date", "Month Start Date", "Value", "Status"}),
				    Good = Table.SelectRows(Expanded, each [Status] = "ok"),
				    Shaped = Table.SelectColumns(Good, {"Series Id", "Series Title", "Unit", "Month Start Date", "Value", "Release Date", "FileName"}),
				    Typed = Table.TransformColumnTypes(Shaped, {{"Series Id", type text}, {"Series Title", type text}, {"Unit", type text}, {"Month Start Date", type date}, {"Value", type number}, {"Release Date", type text}, {"FileName", type text}})
				in
				    Typed
