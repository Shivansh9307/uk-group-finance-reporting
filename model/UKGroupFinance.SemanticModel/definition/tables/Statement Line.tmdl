/// AUTHORED layout of the group income and expenditure statement: one row per line (detail, subtotal, total or spacer), in the order it prints, with the sign it is presented in, its indent, the lines it adds up and the plan scope it is compared with. I wrote the layout (authored/statement_line.csv); no row holds an amount. Account is related to it, so a detail line filters the accounts it adds up. Source view dw.v_model_statement_line.
table 'Statement Line'
	lineageTag: e809a588-2bf7-45f3-a441-e8904dd447e3

	column 'Line Key'
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 561403bd-5a61-4c81-8533-7f55f7934337
		summarizeBy: none
		sourceColumn: line_key

	/// Label of the statement line. A spacer has a label made of zero-width characters, a different number for each, so that the rows stay distinct.
	column Line
		dataType: string
		lineageTag: 91444eb4-a4dd-4b80-b17c-f4f4f41bb84d
		summarizeBy: none
		sourceColumn: label
		sortByColumn: 'Sort Order'

	/// The label with a non-breaking indent in front, one step of three spaces for each indent level.
	column 'Line (indented)'
		dataType: string
		lineageTag: 544c0e18-9a2c-497d-b921-1393b2cd4265
		summarizeBy: none
		sourceColumn: label_indented
		sortByColumn: 'Sort Order'

	/// Short id of the line, for example R50 for net resource expenditure. Used by the authored files and the tests.
	column 'Line Id'
		dataType: string
		lineageTag: b47dfa2b-766e-4e38-b46a-263d17500a4a
		summarizeBy: none
		sourceColumn: line_id
		sortByColumn: 'Sort Order'

	/// detail (adds its accounts), subtotal or total (adds other lines) or spacer (no amount).
	column 'Line Type'
		dataType: string
		lineageTag: 7516731e-85f8-42b0-805b-c79840838159
		summarizeBy: none
		sourceColumn: line_type

	/// as reported (spending positive, income negative, as the source has it) or income positive (the amount is shown with its sign reversed, so income reads as a positive number).
	column 'Sign Presentation'
		dataType: string
		lineageTag: 44a94a7b-0f78-4ece-809c-d8f8c1d6ccb8
		summarizeBy: none
		sourceColumn: sign_presentation

	/// 0 for a net or total line, 1 for a subtotal, 2 for a detail line.
	column 'Indent Level'
		dataType: int64
		formatString: 0
		lineageTag: c612e96a-4dc0-4166-88c9-9bbe09101db6
		summarizeBy: none
		sourceColumn: indent_level

	column 'Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e27cc47b-b16b-4c5e-968c-e21c93e2ef7e
		summarizeBy: none
		sourceColumn: sort_order

	/// The economic budget whose plan the line is compared with (RESOURCE or CAPITAL), ALL for the whole statement, or blank where the source publishes no plan at that level.
	column 'Plan Scope'
		dataType: string
		lineageTag: af040c86-5808-41c3-b9ec-b312e81e16d8
		summarizeBy: none
		sourceColumn: plan_scope

	/// The line ids that a subtotal or total adds up, separated by spaces; blank for a detail line and a spacer.
	column 'Members'
		dataType: string
		lineageTag: 912307b9-63d7-4732-a56d-689145635f9d
		summarizeBy: none
		sourceColumn: members

	/// The keys of the detail lines the line adds up, written |3|4|5|. Hidden: the statement measures read it.
	column 'Detail Line Keys'
		dataType: string
		isHidden
		lineageTag: c7b9243f-0e93-4a37-afdb-6db5b179a80b
		summarizeBy: none
		sourceColumn: detail_line_keys

	partition 'Statement Line' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Data = Source{[Schema = "dw", Item = "v_model_statement_line"]}[Data]
				in
				    Data
