model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Web Sources'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation __TEdtr = 1

ref table 'Fiscal Year'
ref table 'Fiscal Period'
ref table Release
ref table Scenario
ref table Account
ref table 'Control Budget'
ref table Sub-Segment
ref table 'Organisation (as reported)'
ref table 'Department (current structure)'
ref table 'Spending Review Group'
ref table 'Plan Source'
ref table 'Plan Grain'
ref table 'Data Quality Issue'
ref table 'File Control'
ref table 'Plan Coverage'
ref table 'Annual Control'
ref table 'PSS Control'
ref table 'Plan Variance Check'
ref table 'Load Control'
ref table 'Statement Line'
ref table 'TAC Provider'
ref table 'TAC Statement Line'
ref table 'TAC Cash Flow Line'
ref table 'TAC Control Line'
ref table 'TAC Control Member'
ref table 'TAC Consolidated Accounts'
ref table 'Fact Outturn'
ref table 'Fact Plan'
ref table 'Fact Plan Phased (derived)'
ref table 'Fact TAC'
ref table 'Fact TAC Cash Flow (derived)'
ref table 'Time Intelligence'
ref table 'Scenario Comparison'
ref table 'Display Unit'
ref table 'Statement Measure'
ref table Deflator
ref table 'Deflator Quarantine'
ref table CPI
ref table 'CPI Quarantine'
ref table 'User Department (synthetic)'
ref table 'User Plan Group (synthetic)'

ref perspective Executive
ref perspective Restatement
ref perspective 'Data Controls'

ref role 'Department Analyst'
ref role 'Restricted Viewer'
