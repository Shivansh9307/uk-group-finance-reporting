* text=auto
*.tmdl text eol=crlf
*.json text
*.ps1 text eol=crlf
*.sh text eol=lf
*.zip binary
*.xlsx binary
*.png binary

# Published source files are kept byte for byte so their sha256 matches data/manifest/files.csv.
data/committed/** binary
data/manifest/*.csv text eol=lf
# Generated by `ukfr profile ...` with LF line ends; pinned so a rerun leaves git status clean.
data/audit/*.csv text eol=lf
docs/profiling/data/*.csv text eol=lf
# Written by `ukfr build`; pinned to LF so a rebuild leaves git status clean and CI can diff it.
evidence/build/*.csv text eol=lf

# Authored CSV files are text with LF line ends so the loaded text does not depend on git autocrlf.
authored/*.csv text eol=lf
# Synthetic CSV files are text with LF line ends for the same reason.
synthetic/*.csv text eol=lf
# Written by a `--scope full` build (the audit tables that need the large source files); pinned to LF.
evidence/full/*.csv text eol=lf
# Pinned expectations for the real facts (ukfr real-totals --write); LF so the file reads the same everywhere.
evidence/expected/*.csv text eol=lf

# The model tests: expected values written by `ukfr expected`, results written by tools/run_dax_tests.ps1 and the
# comparison written by `ukfr dax-compare`; LF so a rerun leaves git status clean.
tests/expected/*.csv text eol=lf
tests/results/*.csv text eol=lf
evidence/model/*.csv text eol=lf

# Model scripts and Best Practice Analyzer evidence: LF so a rerun leaves git status clean.
evidence/bpa/*.csv text eol=lf
te/scripts/*.csv text eol=lf
te/bpa/*.csv text eol=lf
evidence/perf/real_terms/*.csv text eol=lf

# The role cases of the security tests: expected values written by `ukfr rls-expected`, results written by tools/run_rls_tests.ps1.
tests/rls/expected/*.csv text eol=lf
tests/rls/results/*.csv text eol=lf

# The evidence ledger and what it covers (see docs/evidence.md): LF so the hashes do not depend on autocrlf.
evidence/ledger.json text eol=lf
tests/expected_committed/*.csv text eol=lf
evidence/model/reference/*.csv text eol=lf
tools/model_reference/*.dax text eol=lf
docs/model-reference.md text eol=lf
