// Outturn by financial year and department of the current structure, as the signed-in user sees it. A year in which the
// user's department has no outturn has no row.
EVALUATE
SUMMARIZECOLUMNS (
    'Fiscal Year'[Financial Year],
    'Department (current structure)'[Department Number],
    "outturn", [Outturn]
)
ORDER BY 'Fiscal Year'[Financial Year], 'Department (current structure)'[Department Number]
