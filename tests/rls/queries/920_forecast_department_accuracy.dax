// The department's own forecast on the budget measure totals, over every year and return, for each department of the current structure the
// signed-in user can see: scored cells, absolute error and absolute outturn (GBP thousands) and the WAPE. Only the user's departments; none
// for a user with no department.
EVALUATE
SELECTCOLUMNS (
    FILTER (
        CALCULATETABLE (
            SUMMARIZECOLUMNS (
                'Department (current structure)'[Department],
                "cells", [Forecast Cells],
                "abs_error", [Forecast Abs Error],
                "abs_outturn", [Forecast Abs Outturn],
                "wape", [Forecast WAPE]
            ),
            'Fact Forecast Accuracy (derived)'[Forecast Line] = "Budget measure total",
            'Forecast Method'[Method] = "Department"
        ),
        NOT ISBLANK ( [cells] )
    ),
    "department", 'Department (current structure)'[Department],
    "cells", [cells],
    "abs_error", [abs_error],
    "abs_outturn", [abs_outturn],
    "wape", [wape]
)
ORDER BY [department]
