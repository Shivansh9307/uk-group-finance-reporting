// A provider with no statements in a year contributes nothing to that year's closing balance. Nine real predecessors
// from authored/tac_provider_successor.csv (acquired or merged between 2019-20 and 2023-24), each in all six years:
// the closing cash (BAL1240) the model gives (0 where the provider has no statements) and what a "last non-blank
// balance up to the year" pattern would give, which carries the last balance forward for ever. Defined here: the carry
// forward, which is the pattern the model does not use.
DEFINE
    MEASURE 'Fact TAC'[Carried Forward Closing] =
        CALCULATE (
            LASTNONBLANKVALUE ( 'Fiscal Year'[Year Start], CALCULATE ( [TAC Closing Balance], 'TAC Statement Line'[Sub Code] = "BAL1240" ) ),
            FILTER ( ALL ( 'Fiscal Year' ), 'Fiscal Year'[Year Start] <= MAX ( 'Fiscal Year'[Year Start] ) )
        )
EVALUATE
SELECTCOLUMNS (
    CROSSJOIN (
        CALCULATETABLE ( VALUES ( 'TAC Provider'[Provider Code] ), TREATAS ( { "RBA", "RD3", "RDZ", "RT3", "RW6", "RBZ", "RA4", "RVY", "R1J" }, 'TAC Provider'[Provider Code] ) ),
        CALCULATETABLE ( VALUES ( 'Fiscal Year'[Financial Year] ), TREATAS ( { "2019-20", "2020-21", "2021-22", "2022-23", "2023-24", "2024-25" }, 'Fiscal Year'[Financial Year] ) )
    ),
    "Provider Code", 'TAC Provider'[Provider Code],
    "Financial Year", 'Fiscal Year'[Financial Year],
    "closing_cash", COALESCE ( CALCULATE ( [TAC Closing Balance], 'TAC Statement Line'[Sub Code] = "BAL1240" ), 0 ),
    "carried_forward_cash", COALESCE ( [Carried Forward Closing], 0 )
)
ORDER BY [Provider Code], [Financial Year]
