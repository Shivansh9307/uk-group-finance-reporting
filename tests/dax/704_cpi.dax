// The ONS CPI series the model read over the web, for every month the pinned copies of the two files hold (to
// September 2026). The files are regenerated by ONS each month, so the model can hold later months; they are left
// out of this comparison. Expected values: tests/expected/704_cpi.py.
EVALUATE
SELECTCOLUMNS (
    FILTER ( 'CPI', 'CPI'[Month Start Date] <= DATE ( 2026, 9, 1 ) ),
    "series_id", 'CPI'[Series Id],
    "month", FORMAT ( 'CPI'[Month Start Date], "yyyy-MM-dd" ),
    "value", 'CPI'[CPI Value]
)
ORDER BY [series_id], [month]
