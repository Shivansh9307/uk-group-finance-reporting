// Every Time Intelligence item on Outturn for three financial years and two departments of the current structure,
// at year grain (all periods 0 to 12 of the year in context). 2018-19 has period 0 (amounts not allocated to a
// month), which counts in the year, the year to date and the previous-year comparison base, and has no previous year;
// 2019-20 is a plain year; 2024-25 is a recent year. YoY % is multiplied by one million so the comparison is tight.
EVALUATE
SUMMARIZECOLUMNS (
    'Fiscal Year'[Financial Year],
    'Department (current structure)'[Department Number],
    'Time Intelligence'[Time Calculation],
    TREATAS ( { "2018-19", "2019-20", "2024-25" }, 'Fiscal Year'[Financial Year] ),
    TREATAS ( { "022", "003" }, 'Department (current structure)'[Department Number] ),
    "value",
        IF (
            SELECTEDVALUE ( 'Time Intelligence'[Time Calculation] ) = "YoY %",
            [Outturn] * 1000000,
            [Outturn]
        )
)
ORDER BY 'Fiscal Year'[Financial Year], 'Department (current structure)'[Department Number], 'Time Intelligence'[Time Calculation]
