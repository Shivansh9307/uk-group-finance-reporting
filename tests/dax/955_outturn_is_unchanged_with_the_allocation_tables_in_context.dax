// A structural guard, not independent evidence. The allocation and what-if tables are related to Fiscal Year, Department and Allocation Rule only many to one
// and in a single direction, and the what-if table to nothing, so a filter on them cannot reach Fact Outturn. This test fails if one of those relationships
// becomes bidirectional or a real measure starts to read them: Outturn by financial year is read as it is, with filters on the bridge's rounding row and rule and
// on a what-if setting, and with those three columns cleared (cleared by column: REMOVEFILTERS on a whole table that the year filters also drops the year).
// All three must equal the sum of the revision deltas in the warehouse.
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        'Fiscal Year'[Financial Year],
        "outturn", [Outturn],
        "with_allocation",
            CALCULATE (
                [Outturn],
                'Allocation Bridge (derived)'[Rounding Row] = TRUE (),
                'Allocation Bridge (derived)'[Rule Key] = "CO_ADMIN_FTE",
                'What-if Setting (synthetic)'[Setting Key] = 4
            ),
        "without_allocation",
            CALCULATE (
                [Outturn],
                REMOVEFILTERS ( 'Allocation Bridge (derived)'[Rounding Row] ),
                REMOVEFILTERS ( 'Allocation Bridge (derived)'[Rule Key] ),
                REMOVEFILTERS ( 'What-if Setting (synthetic)'[Setting Key] )
            )
    ),
    "financial_year", 'Fiscal Year'[Financial Year],
    "outturn", [outturn],
    "with_allocation", [with_allocation],
    "without_allocation", [without_allocation]
)
ORDER BY [financial_year]
