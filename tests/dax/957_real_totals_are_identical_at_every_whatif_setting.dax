// A structural guard, not independent evidence. The what-if table is related to nothing and only the what-if measures read it, so selecting a setting
// cannot change a real measure. This test fails if a relationship or a measure ever lets it: the real outturn, the rows of the plan, the allocated amount and
// the annualised paybill at each of the five settings and with none selected must be the same four figures in every row, each equal to its SQL total.
EVALUATE
UNION (
    ROW (
        "setting", "0 none selected",
        "outturn", [Outturn],
        "plan_rows", COUNTROWS ( 'Fact Plan' ),
        "allocated", [Allocated Amount],
        "paybill", [Allocation Paybill (annualised)]
    ),
    SELECTCOLUMNS (
        GENERATESERIES ( 1, 5, 1 ),
        "setting", "" & [Value] & " " & LOOKUPVALUE ( 'What-if Setting (synthetic)'[Setting], 'What-if Setting (synthetic)'[Setting Key], [Value] ),
        "outturn", CALCULATE ( [Outturn], TREATAS ( { [Value] }, 'What-if Setting (synthetic)'[Setting Key] ) ),
        "plan_rows", CALCULATE ( COUNTROWS ( 'Fact Plan' ), TREATAS ( { [Value] }, 'What-if Setting (synthetic)'[Setting Key] ) ),
        "allocated", CALCULATE ( [Allocated Amount], TREATAS ( { [Value] }, 'What-if Setting (synthetic)'[Setting Key] ) ),
        "paybill", CALCULATE ( [Allocation Paybill (annualised)], TREATAS ( { [Value] }, 'What-if Setting (synthetic)'[Setting Key] ) )
    )
)
ORDER BY [setting]
