// Allocated Amount by financial year: the plain form and the rewrite side by side with the pool and their difference. This test checks that each
// form equals its own SQL recomputation (the rewrite adds up to the pool exactly; the plain form is the sum of the rounded products). The two forms
// differ by at most the amount in the result file.
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        'Fiscal Year'[Financial Year],
        "allocated_naive", [Allocated Amount (naive)],
        "allocated_rewrite", [Allocated Amount],
        "pool", [Allocation Pool]
    ),
    "financial_year", 'Fiscal Year'[Financial Year],
    "allocated_naive", [allocated_naive],
    "allocated_rewrite", [allocated_rewrite],
    "pool", [pool],
    "difference", COALESCE ( [allocated_rewrite], 0 ) - COALESCE ( [allocated_naive], 0 )
)
ORDER BY [financial_year]
