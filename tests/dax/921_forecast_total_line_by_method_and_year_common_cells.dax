// The three methods on the budget measure totals (RDEL, CDEL and AME of every department group), by financial year, on the cells that
// every method scored (so R1 to R11 and only where the seasonal guard holds), with every flagged return and without them.
// WAPE and bias are ratios of sums.
EVALUATE
SELECTCOLUMNS (
    CALCULATETABLE (
        SUMMARIZECOLUMNS (
            'Forecast Method'[Method],
            'Fiscal Year'[Financial Year],
            "cells", [Forecast Cells],
            "cells_excl", [Forecast Cells (excl. flagged returns)],
            "abs_error", [Forecast Abs Error],
            "abs_error_excl", [Forecast Abs Error (excl. flagged returns)],
            "wape", [Forecast WAPE],
            "wape_excl", [Forecast WAPE (excl. flagged returns)],
            "bias", [Forecast Bias],
            "bias_excl", [Forecast Bias (excl. flagged returns)]
        ),
        'Fact Forecast Accuracy (derived)'[Forecast Line] = "Budget measure total",
        'Fact Forecast Accuracy (derived)'[Scored By Every Method] = TRUE ()
    ),
    "method", 'Forecast Method'[Method],
    "financial_year", 'Fiscal Year'[Financial Year],
    "cells", [cells],
    "cells_excl", [cells_excl],
    "abs_error", [abs_error],
    "abs_error_excl", [abs_error_excl],
    "wape", [wape],
    "wape_excl", [wape_excl],
    "bias", [bias],
    "bias_excl", [bias_excl]
)
ORDER BY [method], [financial_year]
