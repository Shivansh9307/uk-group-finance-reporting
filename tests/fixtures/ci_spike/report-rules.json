{
  "rules": [
    {
      "id": "MAX_VISUALS_PER_PAGE",
      "name": "No more than four data visuals per page",
      "description": "Fails a page that shows more than paramMaxVisualsPerPage visible visuals, not counting shapes, slicers, buttons and text boxes.",
      "disabled": false,
      "logType": "error",
      "part": "Pages",
      "test": [
        {
          "<=": [
            {
              "count": [
                {
                  "filter": [
                    { "part": "Visuals" },
                    {
                      "and": [
                        { "!": [ { "var": "isHidden" } ] },
                        { "!": [ { "in": [ { "var": "visual.visualType" }, [ "shape", "slicer", "actionButton", "textbox" ] ] } ] }
                      ]
                    }
                  ]
                }
              ]
            },
            { "var": "paramMaxVisualsPerPage" }
          ]
        },
        { "paramMaxVisualsPerPage": 4 },
        true
      ]
    }
  ]
}
